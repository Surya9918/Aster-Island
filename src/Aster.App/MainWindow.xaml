<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Aster.App.MainWindow" Style="{StaticResource {x:Type Window}}" Title="Aster · Control center" Width="1140" Height="780" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped" PreviewDragOver="FilesDragOver">

 <DockPanel Margin="20">

  <Grid DockPanel.Dock="Top" Margin="8,4,8,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

   <StackPanel Orientation="Horizontal"><Viewbox Width="32" Height="32" Margin="0,0,12,0"><Path Fill="{DynamicResource AccentBrush}" Data="M16,0 L20,12 L32,16 L20,20 L16,32 L12,20 L0,16 L12,12 Z" /></Viewbox><StackPanel><TextBlock Text="ASTER" FontWeight="Bold" FontSize="20" /><TextBlock Text="A little space for your day" Style="{StaticResource Caption}" Margin="0" /></StackPanel></StackPanel>

   <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding NetworkState}" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,16,0" /><Button Content="Hide window" Click="HideWindow" ToolTip="Keep Aster in the tray. Ctrl+Alt+Space opens it again." /><Button Content="Quit" Command="{Binding QuitCommand}" /></StackPanel>

  </Grid>

  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,12,8,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite" /></Border>

  <TabControl TabStripPlacement="Left">

   <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,0,0,0">

    <TextBlock Text="Your day, within reach." Style="{StaticResource Heading}" /><TextBlock Text="Local tools. Your choices. No account." Style="{StaticResource Caption}" />

    <WrapPanel>

     <Border Style="{StaticResource Card}" Width="{Binding CardWidth}"><StackPanel><TextBlock Text="RIGHT NOW" Style="{StaticResource Caption}" /><TextBlock Text="{Binding ClockText}" FontSize="48" FontWeight="Light" /><TextBlock Text="{Binding DateText}" /><TextBlock Text="{Binding Battery}" Margin="0,16,0,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Architecture, StringFormat=Native process · {0}}" Style="{StaticResource Caption}" /></StackPanel></Border>

     <Border Style="{StaticResource Card}" Width="{Binding CardWidth}" Visibility="{Binding Preferences.ShowMedia, Converter={StaticResource VisibleWhen}}"><StackPanel><TextBlock Text="NOW PLAYING" Style="{StaticResource Caption}" /><TextBlock Text="{Binding MediaTitle}" FontSize="23" FontWeight="SemiBold" MaxHeight="90" /><TextBlock Text="{Binding MediaArtist}" Style="{StaticResource Caption}" MaxHeight="45" /><WrapPanel Margin="0,12,0,0"><Button Content="Previous" Command="{Binding MediaCommand}" CommandParameter="previous" /><Button Content="{Binding PlayLabel}" Command="{Binding MediaCommand}" CommandParameter="toggle" /><Button Content="Next" Command="{Binding MediaCommand}" CommandParameter="next" /></WrapPanel><TextBlock Text="Uses media information shared with Windows. Cover art comes from the player through Windows. No artwork searches or lyrics downloads." Style="{StaticResource Caption}" /></StackPanel></Border>

     <Border Style="{StaticResource Card}" Width="{Binding CardWidth}"><StackPanel><TextBlock Text="FOCUS" Style="{StaticResource Caption}" /><TextBlock Text="{Binding TimerText}" FontSize="42" FontWeight="Light" /><TextBlock Text="{Binding FocusStatus}" Style="{StaticResource Caption}" /><WrapPanel><Button Content="{Binding TimerButton}" Command="{Binding ToggleFocusCommand}" /><Button Content="Reset 25m" Command="{Binding ResetFocusCommand}" CommandParameter="25" /><Button Content="5m break" Command="{Binding ResetFocusCommand}" CommandParameter="5" /></WrapPanel></StackPanel></Border>

     <Border Style="{StaticResource Card}" Width="{Binding CardWidth}"><StackPanel><TextBlock Text="SOUND &amp; DISPLAY" Style="{StaticResource Caption}" /><TextBlock Text="{Binding AudioState}" /><Slider x:Name="VolumeSlider" Value="{Binding Volume, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,14,0,8" AutomationProperties.Name="Output volume percent" IsEnabled="{Binding AudioAvailable}" /><WrapPanel><Button Content="Apply volume" Click="ApplyVolume" IsEnabled="{Binding AudioAvailable}" /><Button Content="Mute output" Command="{Binding MuteCommand}" /><Button Content="Refresh" Click="RefreshAudio" /></WrapPanel><Button Content="Toggle microphone mute" Command="{Binding MicMuteCommand}" /><TextBlock Text="{Binding MicState}" Style="{StaticResource Caption}" /><TextBlock Text="Changes the default communications input mute state. Does not record sound." Style="{StaticResource Caption}" /><TextBlock Text="{Binding BrightnessState}" /><Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="{Binding Brightness, Mode=OneWay, TargetNullValue=50}" Margin="0,12,0,4" AutomationProperties.Name="Display brightness percent" /><Button Content="Apply brightness" Click="ApplyBrightness" /></StackPanel></Border>

    </WrapPanel>

   </StackPanel></ScrollViewer></TabItem>

   <TabItem Header="File shelf"><Grid Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Keep files close." Style="{StaticResource Heading}" /><TextBlock Text="Drop local files here or choose files. Drag a row back into another app. References persist; Aster never uploads or deletes your files." Style="{StaticResource Caption}" /><Button Content="Choose files" Command="{Binding AddFilesCommand}" HorizontalAlignment="Left" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Shelf}" PreviewMouseLeftButtonDown="ShelfMouseDown" PreviewMouseMove="ShelfMouseMove" AutomationProperties.Name="Local file shelf"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4,8,4"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open" Command="{Binding DataContext.OpenShelfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" /><Button Content="Remove" Command="{Binding DataContext.RemoveShelfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" /></StackPanel><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding State}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>

   <TabItem Header="Clipboard"><Grid Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Only what you choose." Style="{StaticResource Heading}" /><TextBlock Text="Optional text history stays in memory: up to 20 items, 15 minutes, 8,192 characters per item. Off on every launch. Disabling clears it. Passwords may still be copied by apps that do not mark sensitive clipboard data." Style="{StaticResource Caption}" /><CheckBox Content="Enable text history for this session" IsChecked="{Binding ClipboardEnabled}" /><Button Content="Clear Aster history" Command="{Binding ClearClipsCommand}" HorizontalAlignment="Left" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Clips}" AutomationProperties.Name="Session clipboard history"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4,8,4"><StackPanel><TextBlock Text="{Binding Text}" MaxHeight="110" TextTrimming="CharacterEllipsis" /><WrapPanel><Button Content="Copy" Command="{Binding DataContext.CopyClipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Content="Remove" Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>

   <TabItem Header="Notes &amp; tasks"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,0,0,0"><TextBlock Text="A clear place to think." Style="{StaticResource Heading}" /><TextBlock Text="Saved on this Windows account, without sync. Local files are not encrypted." Style="{StaticResource Caption}" /><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="220" MaxLength="100000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Local note" /><TextBlock Text="Small steps" FontSize="20" Margin="0,20,0,8" /><DockPanel><Button DockPanel.Dock="Right" Content="Add task" Command="{Binding AddTaskCommand}" /><TextBox Text="{Binding TaskDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="New task" /></DockPanel><ListBox ItemsSource="{Binding Tasks}" AutomationProperties.Name="Local tasks"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" /><CheckBox Content="{Binding Text}" IsChecked="{Binding Done, Mode=OneWay}" Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" /></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></TabItem>

   <TabItem Header="Launchpad"><StackPanel Margin="18,0,0,0"><TextBlock Text="Your useful things." Style="{StaticResource Heading}" /><TextBlock Text="Choose local executable files. Aster does not scan installed apps. Launched applications have their own privacy and network behavior." Style="{StaticResource Caption}" /><Button Content="Add application" Command="{Binding AddLauncherCommand}" HorizontalAlignment="Left" /><ListBox ItemsSource="{Binding Launchers}" AutomationProperties.Name="Local application launchers"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4,8,4"><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveLauncherCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Content="{Binding Name}" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" /></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></TabItem>

   <TabItem Header="Weather"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,0,0,0"><TextBlock Text="Outside, on your terms." Style="{StaticResource Heading}" /><TextBlock Text="Optional Open-Meteo weather. No location detection or background refresh. Enter coordinates manually using a decimal point. The provider sees these coordinates and your public IP address. Coordinates are not saved." Style="{StaticResource Caption}" /><WrapPanel><Button Content="Allow weather this session…" Command="{Binding PermitWeatherCommand}" /><Button Content="Revoke weather permission" Command="{Binding RevokeWeatherCommand}" /></WrapPanel><TextBlock Text="Latitude (−90 to 90)" /><TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Weather latitude" /><TextBlock Text="Longitude (−180 to 180)" /><TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Weather longitude" /><Button Content="Fetch weather once" Command="{Binding FetchWeatherCommand}" IsEnabled="{Binding NetworkEnabled}" HorizontalAlignment="Left" /><Border Style="{StaticResource Card}" Margin="0,20,0,0"><TextBlock Text="{Binding WeatherText}" FontSize="20" /></Border><TextBlock Text="Weather data: Open-Meteo, CC BY 4.0. WMO code is the provider’s condition code. No live request is required for any other feature." Style="{StaticResource Caption}" /></StackPanel></ScrollViewer></TabItem>

   <TabItem Header="Privacy"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,0,0,0"><TextBlock Text="Private by design." Style="{StaticResource Heading}" /><TextBlock Text="No accounts, analytics, automatic updates, remote artwork, browser, camera recording, microphone recording, or listening ports. Weather is the only app-owned external connection, and it requires explicit session consent." Style="{StaticResource Caption}" /><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding NetworkState}" FontSize="20" /><TextBlock Text="Session network audit · newest first" Style="{StaticResource Caption}" /><TextBlock Text="Only host, purpose, outcome and UTC time are recorded. No coordinates, full URLs, note text, clipboard content or track names." Style="{StaticResource Caption}" /><ListBox ItemsSource="{Binding NetworkEntries}" MinHeight="120" MaxHeight="240" AutomationProperties.Name="Session network audit"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Host}" FontWeight="SemiBold" /><TextBlock Text="{Binding Outcome}" /><TextBlock Text="{Binding Time, StringFormat={}{0:u}}" Style="{StaticResource Caption}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><TextBlock Text="Local storage" FontSize="20" /><TextBlock Text="Preferences, notes, tasks, shelf references and launchers are stored in your local Aster folder. Diagnostic logs contain fixed event codes only. Clipboard history and the network audit are session-only. Local JSON is not encrypted. Launching a file or app hands it to Windows; that external app is outside Aster’s network controls." Style="{StaticResource Caption}" /><Button Content="Delete all Aster data and quit…" Command="{Binding DeleteDataCommand}" HorizontalAlignment="Left" /><TextBlock Text="v0.1 scope: phone sharing, notification mirroring, browser hosting, recording, game overlays and taskbar replacement are not included. See the feature map shipped with the source." Style="{StaticResource Caption}" /></StackPanel></ScrollViewer></TabItem>

   <TabItem Header="Appearance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,0,0,0"><TextBlock Text="Make a little room yours." Style="{StaticResource Heading}" /><TextBlock Text="Changes apply when saved. Font, colors, shape, density and capsule placement are independent settings." Style="{StaticResource Caption}" />

    <TextBlock Text="Theme" /><ComboBox x:Name="ThemeBox" Margin="0,6,8,12" MinHeight="36"><ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" /></ComboBox>

    <TextBlock Text="Accent color · #RRGGBB" /><TextBox x:Name="AccentBox" AutomationProperties.Name="Accent color" />

    <TextBlock Text="Background / card / text colors · optional #RRGGBB overrides" /><UniformGrid Columns="3"><TextBox x:Name="BackgroundBox" AutomationProperties.Name="Background color override" /><TextBox x:Name="CardBox" AutomationProperties.Name="Card color override" /><TextBox x:Name="TextColorBox" AutomationProperties.Name="Text color override" /></UniformGrid>

    <TextBlock Text="Typeface" /><ComboBox x:Name="FontBox" Margin="0,6,8,12" MinHeight="36" IsEditable="True" AutomationProperties.Name="Typeface" />

    <TextBlock Text="Text scale · 85% to 135%" /><Slider x:Name="ScaleSlider" Minimum="0.85" Maximum="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,12,8,16" AutomationProperties.Name="Text scale" />

    <TextBlock Text="Card corners · 0 to 32" /><Slider x:Name="RadiusSlider" Minimum="0" Maximum="32" Margin="0,12,8,16" AutomationProperties.Name="Card corner radius" />

    <TextBlock Text="Expanded island width · 540 to 680" /><Slider x:Name="WidthSlider" Minimum="540" Maximum="680" Margin="0,12,8,16" AutomationProperties.Name="Expanded island width" />

    <TextBlock Text="Window opacity · 85% to 100%" /><Slider x:Name="OpacitySlider" Minimum="0.85" Maximum="1" Margin="0,12,8,16" AutomationProperties.Name="Window opacity" />

    <TextBlock Text="Capsule top offset · 0 to 160" /><Slider x:Name="OffsetSlider" Minimum="4" Maximum="160" Margin="0,12,8,16" AutomationProperties.Name="Capsule top offset" />

    <TextBlock Text="Capsule display" /><ComboBox x:Name="MonitorBox" Margin="0,6,8,12" MinHeight="36" AutomationProperties.Name="Capsule display" />

    <TextBlock Text="Card density" /><ComboBox x:Name="LayoutBox" Margin="0,6,8,12" MinHeight="36"><ComboBoxItem Content="Balanced" /><ComboBoxItem Content="Compact" /></ComboBox>

    <TextBlock Text="Island glass opacity · 80% to 100%" /><Slider x:Name="GlassSlider" Minimum="0.8" Maximum="1" Margin="0,12,8,16" AutomationProperties.Name="Island glass opacity" />

    <TextBlock Text="Island scale · 85% to 120%" /><Slider x:Name="IslandScaleSlider" Minimum="0.85" Maximum="1.2" Margin="0,12,8,16" AutomationProperties.Name="Island scale" />

    <TextBlock Text="Spring stiffness / damping / mass" /><UniformGrid Columns="3"><TextBox x:Name="StiffnessBox" AutomationProperties.Name="Spring stiffness" /><TextBox x:Name="DampingBox" AutomationProperties.Name="Spring damping" /><TextBox x:Name="MassBox" AutomationProperties.Name="Spring mass" /></UniformGrid>

    <TextBlock Text="Default 420 / 38 / 1. Higher damping reduces bounce. Changes preserve motion continuity." Style="{StaticResource Caption}" />

    <CheckBox x:Name="OverlayCheck" Content="Show floating island" /><CheckBox x:Name="MediaCheck" Content="Show media card" /><CheckBox x:Name="BatteryCheck" Content="Show battery in local tools" /><CheckBox x:Name="MotionCheck" Content="Reduce motion" />

    <TextBlock Text="Desktop integration" FontSize="20" Margin="0,18,0,8" />

<CheckBox x:Name="AutoStowCheck" Content="Tuck into the top bar for maximized and fullscreen apps" />

<CheckBox x:Name="VolumeKeysCheck" Content="Use the island instead of Windows' volume-key flyout" />

<CheckBox x:Name="BrightnessKeysCheck" Content="Use learned brightness keys for the island" />

<WrapPanel><Button Content="Teach brightness down…" Command="{Binding LearnDimCommand}" /><Button Content="Teach brightness up…" Command="{Binding LearnBrightCommand}" /></WrapPanel>

<TextBlock Text="Ctrl+Alt+Up/Down adjusts brightness through Aster. Some firmware keys cannot be intercepted; teaching times out without changing them." Style="{StaticResource Caption}" />

<TextBlock Text="{Binding HardwareStatus}" Style="{StaticResource Caption}" />

<CheckBox x:Name="SpotifyWallpaperCheck" Content="Spotify atmosphere · blurred cover wallpaper"/><TextBlock Text="Uses the Spotify desktop app’s shared cover art. Keeps your wallpaper for restoration. Windows controls desktop transition effects." Style="{StaticResource Caption}"/><TextBlock Text="{Binding WallpaperStatus}" Style="{StaticResource Caption}"/><CheckBox x:Name="CustomDockCheck" Content="Use Aster dock instead of the Windows taskbar"/><TextBlock Text="Right-click the dock to restore Windows. Ctrl+Alt+Shift+T restores it immediately. The chevron reveals the Windows taskbar for 12 seconds." Style="{StaticResource Caption}"/><CheckBox x:Name="DockBrowserCheck" Content="Keep a browser shortcut in the dock"/><TextBlock Text="Dock scale"/><Slider x:Name="DockScaleSlider" Minimum="0.75" Maximum="1.25" Margin="0,12,8,16"/><CheckBox x:Name="TaskbarGlassCheck" Content="Apply reversible glass material to the Windows taskbar" />

<TextBlock Text="Experimental: Windows may accept the material request without changing its taskbar artwork. Quit Aster to restore the captured material." Style="{StaticResource Caption}" />

<TextBlock Text="{Binding TaskbarStatus}" Style="{StaticResource Caption}" />

<TextBlock Text="Windows taskbar tint strength" /><Slider x:Name="TaskbarTintSlider" IsEnabled="{Binding TaskbarTintAvailable}" Minimum="40" Maximum="220" Margin="0,12,8,16" AutomationProperties.Name="Windows taskbar tint opacity" />

<TextBlock Text="Island glass highlights" /><Slider x:Name="ShineSlider" Minimum="0.4" Maximum="2" Margin="0,12,8,16" AutomationProperties.Name="Glass highlight intensity" />

<WrapPanel><Button Content="Save appearance" Click="SaveAppearance" /><Button Content="Reset appearance" Click="ResetAppearance" /></WrapPanel><TextBlock Text="Ctrl+Alt+Space opens the control center. Closing the window hides it; use Quit to stop Aster. No automatic startup entry is created." Style="{StaticResource Caption}" />

   </StackPanel></ScrollViewer></TabItem>

  </TabControl>

 </DockPanel>

</Window>





